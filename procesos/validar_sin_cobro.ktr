              <type>Integer</type>
              <text>1</text>
              <length>-1</length>
              <precision>0</precision>
              <isnull>N</isnull>
              <mask>####0;-####0</mask>
            </value>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND</operator>
            <conditions>
              <condition>
                <negated>N</negated>
